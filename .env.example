OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set DATABASE_URL to use the PostGIS database in Docker or production.
DATABASE_URL=postgis://map2:map2postgres123@localhost:5432/map2
DB_ENGINE=postgis
DB_NAME=map2
DB_USER=map2
DB_PASSWORD=map2postgres123
DB_HOST=localhost
DB_PORT=5432
NEO4J_URL=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=map2neo4j123
REDIS_URL=redis://redis:6379/0
MAP_AUTH_REDIS_REQUIRED=true
MAP_AUTH_ACCESS_TTL_SECONDS=600
MAP_AUTH_REFRESH_IDLE_SECONDS=604800
MAP_AUTH_REFRESH_ABSOLUTE_SECONDS=2592000
MAP_AUTH_REFRESH_IDEMPOTENCY_SECONDS=10
MAP_AUTH_LOGIN_ATTEMPTS=10
MAP_AUTH_LOGIN_WINDOW_SECONDS=900
MAP_AUTH_COOKIE_SECURE=false
MAP_AUTH_COOKIE_SAMESITE=Lax
MAP_MAX_SSE_CONNECTIONS=500
MAP_MAX_SSE_CONNECTIONS_PER_USER=4
MAP_MAX_SSE_CONNECTIONS_PER_SESSION=1
MAP_SSE_LEASE_TTL_SECONDS=60
MAP_MAX_STREAM_REQUESTS=20
MAP_MAX_ACTIVE_RUNS_PER_USER=3
MAP_MAX_ACTIVE_RUNS=32
MAP_SSE_HEARTBEAT_SECONDS=15
MAP_SSE_REAUTH_LEAD_SECONDS=120
MAP_SSE_REDIS_MAXLEN=1000
MAP_SSE_REDIS_TTL_SECONDS=86400
MAP_SSE_REDIS_MAX_CONNECTIONS=50
MAP_SSE_COALESCE_WINDOW_MS=200
MAP_GEOJSON_LIMIT=8000
MAP_WORKER_LIMIT=30000
OUTPUT_DIR=outputs
DATA_DIRECTORY_BASE=data
DATA_CACHE_DIR=data_cache
NEO4J_CLEAR_DB=false
NEO4J_USE_APOC=false
